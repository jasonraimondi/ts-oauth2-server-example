{
  "name": "jmondi-oauth2-example-server",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "oxlint --type-aware --deny-warnings src tests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:seed": "tsx src/db/seed.ts",
    "db:prune": "tsx src/db/prune.ts",
    "cf:dev": "wrangler dev",
    "cf:migrate": "wrangler d1 migrations apply DB",
    "cf:seed": "scripts/d1-seed.sh",
    "cf:deploy": "wrangler deploy",
    "db:reset": "rm -f data/oauth.db data/oauth.db-* && pnpm db:migrate && pnpm db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.8.0",
    "@jmondi/date-duration": "^0.1.1",
    "@jmondi/oauth2-server": "5.0.0",
    "@libsql/client": "^0.17.4",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260821.1",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.8",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.68.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.125.0"
  }
}
