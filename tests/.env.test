NODE_ENV=test
DATABASE_URL="postgresql://oauth:secret@localhost:8888/oauth_test"
# The suite drives login/token many times from one address; lift the rate-limit
# ceiling so normal test traffic never trips it (the limiter's 429 behavior is
# covered in isolation by tests/rate-limit.test.ts).
LOGIN_RATE_MAX=1000000
TOKEN_RATE_MAX=1000000

# bcrypt cost 4 instead of the default 12: the suite hashes on nearly every
# request and the KDF's real cost dominates its wall-clock. Verification reads
# the cost out of each stored hash, so seeded rows stay valid either way.
BCRYPT_COST=4
