# Gates every insecure local-development convenience (hardcoded session secret,
# ephemeral OIDC key, non-Secure cookies). Only "development" or "test" opts in —
# anything else, including leaving this unset, fails closed.
NODE_ENV="development"

# Port the server listens on.
PORT=3000

# SQLite database file (libsql URL). Created on first migrate.
DATABASE_URL="file:./data/oauth.db"

# OIDC issuer; also the base URL for the discovery + JWKS endpoints. Must be the
# externally reachable URL, byte-for-byte and with no trailing slash — the BFF
# compares it against the discovery document. Must be https:// outside development.
OIDC_ISSUER="http://localhost:3000"

# RSA private key (PEM) used to sign OIDC tokens; the public half is published at
# /.well-known/jwks.json. Newlines may be escaped as \n on a single line. Outside
# development an ephemeral key is refused, so this is required. Generate one:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# OIDC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Symmetric secret (HS256, at least 32 characters) for the browser session cookie
# ("jid"). Deliberately separate from the OIDC signing key — it lives in a
# different trust domain. Outside development the insecure dev default is refused,
# so this is required.
# SESSION_SECRET="change-me-to-a-long-random-string"

# Failed-login ceiling per client IP, per 15 minutes.
LOGIN_RATE_MAX=10

# Token-endpoint ceiling per client IP, per minute.
TOKEN_RATE_MAX=60

# Set to true only when a reverse proxy you control rewrites X-Forwarded-For.
# Left false, the client IP comes from the socket, which nobody can spoof.
TRUST_PROXY=false

# bcrypt work factor for password and client-secret hashes. Values below 12 are
# honored only under NODE_ENV=development or test (the test suite uses 4).
# BCRYPT_COST=12
